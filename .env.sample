CLIENT_ID="<Enter_your_client_id>"
CLIENT_SECRET="<Enter_your_client_secret>"
AUTHORITY=https://<Enter_your_subdomain>.ciamlogin.com/<Enter_your_tenant_id>
# パスキーの rp.id はテナントのドメインになるため、アプリもそのサブドメインから配信する
REDIRECT_URI="https://auth.<Enter_your_subdomain>.ciamlogin.com:3000/getAToken"
# アプリ専用トークン (client credentials) は ciamlogin.com の authority では取得できず、
# login.microsoftonline.com/<TENANT_ID> を使うため個別に必要
TENANT_ID="<Enter_your_tenant_id>"
